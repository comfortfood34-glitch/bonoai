        """Helper to create a draw."""
        draw = Draw(
            contest_id=contest_id,
            held_on=held_on,
            numbers=(1, 2, 3, 4, 5, 6),
            complementary=7,
            reintegro=8,
        )
        provenance = SourceProvenance(
            source_name="test",
